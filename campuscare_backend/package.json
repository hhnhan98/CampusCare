{
  "name": "campuscare_backend",
  "version": "1.0.0",
  "description": "REST API backend for the CampusCare mobile application",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:test": "node --env-file=.env src/scripts/test-database.js",
    "seed": "node --env-file=.env prisma/seed.js",
    "seed:demo": "node --env-file=.env prisma/demo-seed.js"
  },
  "keywords": [
    "campuscare",
    "express",
    "rest-api",
    "postgresql",
    "prisma"
  ],
  "author": "Ho Hoang Nhan",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.19.0"
  }
}
